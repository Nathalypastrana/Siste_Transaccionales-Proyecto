# Plantilla de variables de entorno. Copia este archivo a ".env" (que Git ignora), pon tus valores y cárgalo con:
#   set -a; source .env; set +a
# NUNCA subas el archivo .env ni pongas valores reales en este archivo de ejemplo.

# --- Base de datos (obligatorias) ---
DB_USER=hotel_app
DB_PASSWORD=

# --- Seguridad de la aplicación ---
# Mínimo 32 caracteres aleatorios. Genera uno con:  openssl rand -base64 36
JWT_SECRET=
# Primer administrador general (solo se usa si aún no existe uno). Contraseña de mínimo 8 caracteres.
ADMIN_CORREO=
ADMIN_PASSWORD=
JWT_MINUTOS=120

# --- Consultor de IA ---
ASISTENTE_PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
# true solo en desarrollo/demostración; en producción debe ser false
ASISTENTE_SIMULADOR=false

# --- Correo (recuperación de contraseña y notificaciones) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:5173

# --- WhatsApp: proveedor meta (Cloud API) o twilio (Sandbox de Twilio, no exige verificar el negocio) ---
WHATSAPP_PROVEEDOR=meta

# --- WhatsApp (Twilio) --- solo con WHATSAPP_PROVEEDOR=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# URL pública del backend (ngrok), sin barra final. Ej.: https://xxxx.ngrok-free.app
TWILIO_URL_PUBLICA=

# --- WhatsApp (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PLANTILLA_RESERVA=
RECEPCION_WHATSAPP=

# --- Notificaciones ---
NOTIFICACIONES_CANALES=correo,whatsapp
NOMBRE_HOTEL='Hotel En mi pueblito'
